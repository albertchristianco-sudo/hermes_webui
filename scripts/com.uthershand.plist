<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.uthershand</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/TO/hermes_webui/server/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/REPLACE/WITH/ABSOLUTE/PATH/TO/hermes_webui</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- Uncomment and set to enable a shared password (recommended even on Tailscale): -->
    <!--
    <key>HERMES_WEBUI_PASSWORD</key>
    <string>change-me</string>
    -->
    <key>HERMES_WEBUI_PORT</key>
    <string>18888</string>
    <key>HERMES_WEBUI_HOST</key>
    <string>0.0.0.0</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/uthers-hand.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/uthers-hand.err.log</string>
</dict>
</plist>
